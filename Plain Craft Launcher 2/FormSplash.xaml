<Window x:Class="PCL.FormSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plain Craft Launcher - Harness Edition"
        Width="420" Height="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        FontFamily="{DynamicResource LaunchFontFamily}">
    <!--
        PCL-HE 开屏动画窗口（原创实现）
        替换 PCL CE 原生的静态 System.Windows.SplashScreen，提供带动画的开屏体验。

        设计目标：不与主界面割裂。
        初版使用「深色实体卡片」，而主界面默认是浅色主题，一深一浅造成突兀感；
        现改为 —— 不使用实体卡片，让虎鲸与文字直接浮在透明背景上，
        且所有颜色均取自当前主题资源（ColorBrush1/3/7、ColorObject3），
        因此无论浅色还是深色主题，开屏与主界面都同源同调。
        虎鲸使用品牌蓝色的鲸鱼图形，在深浅两种桌面上都清晰可辨。
    -->
    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" CenterX="210" CenterY="140" />
        </Grid.RenderTransform>

        <!-- 轻量背景板：使用主题背景色而非硬编码深色。
             背景板保证文字在任何桌面壁纸上都清晰可读，而取自主题的颜色
             则保证它不会与主界面产生「一深一浅」的割裂感。 -->
        <Border x:Name="Card" Margin="6" CornerRadius="10"
                Background="{DynamicResource ColorBrushBg1}">
        <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- PCL-HE 六边形字标，带品牌蓝辉光 -->
            <Viewbox x:Name="LogoBox" Width="84" Height="84" Opacity="0"
                     HorizontalAlignment="Center">
                <Viewbox.RenderTransform>
                    <TranslateTransform x:Name="LogoShift" Y="10" />
                </Viewbox.RenderTransform>
                <Viewbox.Effect>
                    <DropShadowEffect Color="#1370F3" BlurRadius="26" ShadowDepth="0" Opacity="0.42" />
                </Viewbox.Effect>
                <Image Source="/Images/logo_he.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Viewbox>

            <TextBlock x:Name="LabTitle" Text="Plain Craft Launcher"
                       HorizontalAlignment="Center" Margin="0,20,0,0"
                       FontSize="22" FontWeight="Light" Opacity="0"
                       Foreground="{DynamicResource ColorBrush1}" />

            <TextBlock x:Name="LabSub" Text="H A R N E S S   E D I T I O N"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       FontSize="10" FontWeight="Bold" Opacity="0"
                       Foreground="{DynamicResource ColorBrush3}" />
        </StackPanel>

            <!-- 底部光带进度指示。
                 刻意放在 StackPanel 之外、以 VerticalAlignment=Bottom 贴底定位：
                 若与标识文字同处一个居中 StackPanel，它会随内容增高而被挤出可视区。 -->
            <Grid x:Name="ProgressTrack" Width="200" Height="3" Opacity="0"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,30" ClipToBounds="True">
                <Border Background="{DynamicResource ColorBrush5}" Opacity="0.6" CornerRadius="1.5" />
                <Border Width="86" HorizontalAlignment="Left" CornerRadius="1.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressShift" X="-100" />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#001370F3" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.5" />
                            <GradientStop Color="#001370F3" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
