<Grid x:Class="PCL.MyMsgJavaPath"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:PCL"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="640" MaxWidth="820"
      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-4" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushBackground}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20" ShadowDepth="2"
                              RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}"
                       HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="选择安装位置"
                       VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <my:MyScrollViewer Grid.Row="3" VerticalAlignment="Top" x:Name="PanCaption" Margin="0,0,0,17"
                               Padding="7,0,15,0"
                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                               DeltaMult="0.7">
                <StackPanel x:Name="PanText">
                    <TextBlock x:Name="LabTarget" TextWrapping="Wrap" FontSize="14" Opacity="0.75" Margin="0,0,0,13" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Opacity="0.7" Margin="0,0,0,14"
                               Text="安装位置决定这个 Java 占哪块硬盘的空间，装完之后也可以在「应用和功能」里随意卸载。这里选错了不会影响游戏能不能跑，只会多占或少占一点地方。" />

                    <RadioButton x:Name="RadioSystem" GroupName="JavaPathMember" FontSize="14" Margin="0,0,0,3"
                                 Checked="Radio_Checked" Content="系统默认位置" />
                    <TextBlock x:Name="TextSystem" TextWrapping="Wrap" FontSize="12.5" Opacity="0.6"
                               Margin="22,0,0,13" />

                    <RadioButton x:Name="RadioLauncher" GroupName="JavaPathMember" FontSize="14" Margin="0,0,0,3"
                                 Checked="Radio_Checked" Content="放进启动器文件夹" />
                    <TextBlock x:Name="TextLauncher" TextWrapping="Wrap" FontSize="12.5" Opacity="0.6"
                               Margin="22,0,0,13" />

                    <RadioButton x:Name="RadioCustom" GroupName="JavaPathMember" FontSize="14" Margin="0,0,0,6"
                                 Checked="Radio_Checked" Content="自定义文件夹" />
                    <Grid Margin="22,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <my:MyTextBox x:Name="TextCustom" Grid.Column="0" Height="26" FontSize="13"
                                      VerticalAlignment="Center" />
                        <my:MyButton x:Name="BtnBrowse" Grid.Column="1" Margin="8,0,0,0" Height="26" MinWidth="76"
                                     Text="选择" Click="BtnBrowse_Click" />
                    </Grid>

                    <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18" Opacity="0.55"
                               Text="安装需要管理员授权，Windows 会弹出一次确认框。装到启动器文件夹时，请先确认那个位置不是只读的移动硬盘或网络盘。" />
                    <Border HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                   Foreground="{DynamicResource ColorBrushRedLight}"
                                   Text="请选一个空文件夹：卸载或升级时，Windows 会把这里整个删掉。" />
                    </Border>
                </StackPanel>
            </my:MyScrollViewer>
            <StackPanel Grid.Row="4" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="150,0,8,0" Orientation="Horizontal">
                <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="确定" Click="Btn1_Click" x:Name="Btn1"
                             Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="取消" Click="Btn2_Click" x:Name="Btn2"
                             Margin="12,0,0,0"
                             TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
